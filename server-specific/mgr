#!/bin/bash
# mgr — Marc's direct line to CLAUDEMANAGER, from ANY terminal or ANY Claude session.
#
# Why it exists (12 Aug 2026): cross-session messaging works, but it needs a
# relay agent ("tell that agent to SendMessage ubuntu-0f..."). Marc wanted to
# write to the manager HIMSELF, in his own words, with no interpreter in between.
#
#   mgr "hey manager, we're extending FF"     → sends. The manager sees it within seconds.
#   mgr                                        → shows the manager's replies (newest last).
#
# Inside a Claude session, prefix with "!":   ! mgr "your message"
#
# Mechanism: appends to ~/.claudemanager.msgs. The manager keeps a Monitor armed
# on that file, so the line lands in its conversation the moment it's written.
# The file IS the durable record — if the manager is dead/recycling, the message
# waits there and the next boot's open-check picks it up.

MSGS="$HOME/.claudemanager.msgs"
REPLIES="$HOME/.claudemanager.replies"

# No args → show the manager's replies
if [ $# -eq 0 ]; then
  if [ -s "$REPLIES" ]; then
    tail -40 "$REPLIES"
  else
    echo "(no replies yet — the manager answers here, and pushes important ones to your phone)"
  fi
  exit 0
fi

# --- Who is writing, and how the manager answers them ----------------------
# Added 12 Aug 2026. Without this, a message arrived with no return address: the
# manager had to grep every session transcript to guess which one Marc was sitting
# in, and still got it wrong. A shell launched inside a Claude session already
# knows — these variables are set for it — so the message carries them.
#   CLAUDE_CODE_MESSAGING_SOCKET → the exact SendMessage address of that session
#   CLAUDE_CODE_SESSION_ID       → its transcript, at ~/.claude/projects/*/<id>.jsonl
#   its --name flag              → the display name Marc sees in /list-agents
FROM="terminal (fuera de una sesión Claude)"
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  NAME=""
  if [ -n "${CLAUDE_PID:-}" ]; then
    CMD="$(ps -o args= -p "$CLAUDE_PID" 2>/dev/null)"
    case "$CMD" in
      *--name\ *) NAME="$(printf '%s' "$CMD" | sed -n 's/.*--name \(.*\)/\1/p' | sed 's/ --.*//')" ;;
      *-n\ *)     NAME="$(printf '%s' "$CMD" | sed -n 's/.*-n \(.*\)/\1/p'     | sed 's/ --.*//')" ;;
    esac
  fi
  [ -n "$NAME" ] || NAME="sin nombre (arrancada sin --name)"
  FROM="sesión «$NAME» · id ${CLAUDE_CODE_SESSION_ID%%-*}"
  [ -n "${CLAUDE_CODE_MESSAGING_SOCKET:-}" ] && FROM="$FROM · responder con SendMessage to=uds:${CLAUDE_CODE_MESSAGING_SOCKET}"
fi

printf '[%s] MARC (desde: %s): %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$FROM" "$*" >> "$MSGS"
echo "→ sent to the manager. (see replies: mgr)"
