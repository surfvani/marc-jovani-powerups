#!/bin/bash
# CLAUDEMANAGER open-check — the D15 boot/hop ritual as one command.
# Exists because three consecutive hops (9 Aug 2026) composed the inline
# version without its leading `cd` and ran `git pull` wherever the shell
# happened to sit — once inside app_cc (D7 violation, zero damage by luck).
# The cd is baked in here; hops call this absolute path and nothing else.
cd /home/ubuntu/NORTH_STAR || { echo "FATAL: NORTH_STAR missing"; exit 1; }
touch ~/.claudemanager.heartbeat
git pull 2>&1 | tail -2
echo "--- diff since close:"
git diff --name-only "$(cat /home/ubuntu/NORTH_STAR/BOARDS/PROJECT_HERO/.last-close-sha)"..HEAD
echo "--- HEAD:"
# HEAD check baked in (10 Aug 2026): hops kept composing `git log` inline
# without its cd — same failure family as the 9 Aug pull. Never compose it.
git log --format='%h %ad %s' --date=format:'%d%b %H:%M' -2
echo "--- $(date)"

# --- Marc's direct line (mgr): surface anything not yet seen ---------------
# Mechanized 12 Aug 2026, same day the line was built. The persona told the
# boot to re-read ~/.claudemanager.msgs by hand — but a memorized rule is how
# the 9 Aug cwd bug survived three hops. This runs at EVERY boot and EVERY hop,
# so a message written while the manager was dead can never be silently lost.
# It may reprint a line the live Monitor already delivered; that costs one echo
# and is the safe direction to err.
MSGS="$HOME/.claudemanager.msgs"; SEEN="$HOME/.claudemanager.msgs.seen"
if [ -s "$MSGS" ]; then
  total=$(wc -l < "$MSGS"); seen=$(cat "$SEEN" 2>/dev/null || echo 0)
  case "$seen" in ''|*[!0-9]*) seen=0 ;; esac
  if [ "$total" -gt "$seen" ]; then
    echo "--- MARC DIRECT LINE (mgr) — $((total - seen)) new, ANSWER IN ~/.claudemanager.replies:"
    tail -n "$((total - seen))" "$MSGS"
    echo "$total" > "$SEEN"
  fi
fi
