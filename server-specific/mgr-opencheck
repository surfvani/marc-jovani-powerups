#!/bin/bash
# CLAUDEMANAGER open-check — the D15 boot/hop ritual as one command.
# Exists because three consecutive hops (9 Aug 2026) composed the inline
# version without its leading `cd` and ran `git pull` wherever the shell
# happened to sit — once inside app_cc (D7 violation, zero damage by luck).
# The cd is baked in here; hops call this absolute path and nothing else.

# --- AM I THE SANCTIONED MANAGER? (first thing, every boot and every hop) ---
# 15 Aug 2026: two live processes shared session a81474e2 and both acted as the
# manager for ~30 minutes. Identity is the PROCESS, not a file: the sanctioned
# manager is the claude running inside tmux session cs-manager, which is already
# how the watchdog, rotate, status and unstick all define it.
# ~/.claudemanager.lock proves NOTHING — it is a start-path mutex released ~30s
# after boot (verified 15 Aug: `flock -n` acquires it instantly while the manager
# is live). Checking it would have caught nothing.
# This runs here, and not as a remembered rule, for the same reason the cd and the
# mgr-line drain live here: a memorized rule is what failed on 9 Aug.
MGR_PID="$(tmux list-panes -t cs-manager -F '#{pane_pid}' 2>/dev/null | head -1)"
if [ -n "$MGR_PID" ] && [ -n "${CLAUDE_PID:-}" ] && [ "$CLAUDE_PID" != "$MGR_PID" ]; then
  echo "!!! ==================================================================="
  echo "!!! YOU ARE NOT THE SANCTIONED MANAGER."
  echo "!!! A live manager is running in tmux cs-manager (pid $MGR_PID)."
  echo "!!! You are pid $CLAUDE_PID. Two managers writing one board is the"
  echo "!!! failure the Iron Rules call two hands on one wheel."
  echo "!!!"
  echo "!!! STAND DOWN NOW — no board writes, no plan edits, no [mgr] commits,"
  echo "!!! no manager hops, no /manager-close, no heartbeat touches."
  echo "!!! Tell Marc you are a duplicate. HE decides which one survives."
  echo "!!! ==================================================================="
fi

# --- WAS I RELIEVED, OR DID I DIE? + WHERE MY PREDECESSOR'S MEMORY LIVES --------
# 18 Aug 2026. The box OOM-killed the manager at 21:30:55 mid-command; the watchdog
# respawned it 5 minutes later; the fresh session found a handover marker touched 9.5
# hours earlier "as a safety net", read it as a clean relevo, and never confessed the
# death — Marc discovered a 20-minute hole on his own. Two mechanical fixes live here:
#   1. the handover verdict is COMPUTED, not remembered (claudemanager handover-check),
#      and a bare marker older than 3h no longer passes as a sanctioned relevo;
#   2. every session records WHERE ITS OWN TRANSCRIPT IS and WHEN IT LAST FLUSHED, so a
#      successor born of a crash can read exactly the stretch its predecessor never got
#      to write down — the mid-shift handover briefing, recovered from the corpse.
# This block runs on the FIRST run of a new session (the boot); on later hops it only
# refreshes the watermark, which is what makes "since the last flush" meaningful.
SESSFILE="$HOME/.claudemanager.session"
MY_ID="${CLAUDE_CODE_SESSION_ID:-unknown}"
MY_TX="$(find /home/ubuntu/.claude/projects -name "$MY_ID.jsonl" 2>/dev/null | head -1)"
read -r PREV_ID PREV_AT PREV_TX < "$SESSFILE" 2>/dev/null || true
if [ "$MY_ID" != "${PREV_ID:-}" ]; then
  VERDICT="$(/home/ubuntu/.local/bin/claudemanager handover-check --consume)"
  echo "--- BOOT · handover verdict: $VERDICT"
  case "$VERDICT" in
    CLEAN*)
      echo "    → clean relevo. Take over silently; Marc never sees the seam." ;;
    *)
      echo "    → ⚠️  UNSANCTIONED DEATH (no valid marker). CONFESS IT to Marc in your"
      echo "       next brief or contact — with the window: predecessor last flushed"
      echo "       ${PREV_AT:+$(date -d "@$PREV_AT" '+%H:%M %Z') on $(date -d "@$PREV_AT" '+%d %b')}${PREV_AT:+, }you booted $(date '+%H:%M %Z')."
      if [ -n "${PREV_TX:-}" ] && [ -f "${PREV_TX:-/nonexistent}" ]; then
        echo "       RECOVER THE UNFLUSHED STRETCH (everything before it is already on the"
        echo "       board — this is the only part that exists nowhere else):"
        echo "         /home/ubuntu/.local/bin/mgr-tail ${PREV_AT:-0}"
      else
        echo "       (no predecessor transcript recorded — first run after this upgrade,"
        echo "        or the session file was cleared)"
      fi ;;
  esac
fi
printf '%s %s %s\n' "$MY_ID" "$(date +%s)" "${MY_TX:-none}" > "$SESSFILE"

cd /home/ubuntu/NORTH_STAR || { echo "FATAL: NORTH_STAR missing"; exit 1; }
touch ~/.claudemanager.heartbeat
git pull 2>&1 | tail -2
echo "--- diff since close:"
git diff --name-only "$(cat /home/ubuntu/NORTH_STAR/BOARDS/PROJECT_HERO/.last-close-sha)"..HEAD
echo "--- HEAD:"
# HEAD check baked in (10 Aug 2026): hops kept composing `git log` inline
# without its cd — same failure family as the 9 Aug pull. Never compose it.
git log --format='%h %ad %s' --date=format:'%d%b %H:%M' -2
echo "--- $(date)"

# --- Marc's direct line (mgr): surface anything not yet seen ---------------
# Mechanized 12 Aug 2026, same day the line was built. The persona told the
# boot to re-read ~/.claudemanager.msgs by hand — but a memorized rule is how
# the 9 Aug cwd bug survived three hops. This runs at EVERY boot and EVERY hop,
# so a message written while the manager was dead can never be silently lost.
# It may reprint a line the live Monitor already delivered; that costs one echo
# and is the safe direction to err.
MSGS="$HOME/.claudemanager.msgs"; SEEN="$HOME/.claudemanager.msgs.seen"
if [ -s "$MSGS" ]; then
  total=$(wc -l < "$MSGS"); seen=$(cat "$SEEN" 2>/dev/null || echo 0)
  case "$seen" in ''|*[!0-9]*) seen=0 ;; esac
  if [ "$total" -gt "$seen" ]; then
    echo "--- MARC DIRECT LINE (mgr) — $((total - seen)) new, ANSWER IN ~/.claudemanager.replies:"
    tail -n "$((total - seen))" "$MSGS"
    echo "$total" > "$SEEN"
  fi
fi
