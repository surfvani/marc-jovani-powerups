#!/usr/bin/env python3
# Auto-route to the dedicated venv if present (so cc-gads works regardless of
# which python3 is on PATH). The venv is created per-machine by install.sh.
import os as _os, sys as _sys
_VENV_PY = _os.path.expanduser("~/.config/cc-google-ads/venv/bin/python3")
if _os.path.isfile(_VENV_PY) and _sys.executable != _VENV_PY:
    # Re-exec with the venv's python so SDK + click are importable. Compare
    # sys.executable verbatim (no realpath) — venv's python3 is typically a
    # symlink to the system binary, so realpath would flatten them and the
    # auto-route would never fire.
    _os.execv(_VENV_PY, [_VENV_PY] + _sys.argv)

"""cc-gads — Cinematic Composing Google Ads write CLI.

Hardcoded policy. Dry-run default. CEP-protocol-friendly output.
Writes audit log to ~/.config/cc-google-ads/audit.log.

Usage:
  cc-gads list-campaigns [--status=ENABLED|PAUSED|REMOVED|ALL]
  cc-gads list-ad-groups <campaign_id>
  cc-gads set-budget <campaign_id> <new_amount_usd> [--confirm]
  cc-gads set-bid <ad_group_id> <new_cpc_usd> [--confirm]
  cc-gads pause-campaign <campaign_id> [--confirm]
  cc-gads enable-campaign <campaign_id> [--confirm]
  cc-gads add-negative-keyword <campaign_id> <keyword> [--match=exact|phrase|broad] [--confirm]
  cc-gads set-tracking-template [--campaign-id ID | --ad-group-id ID | --from-tsv PATH] --template TEXT [--confirm]

Defaults to dry-run for every mutation. Pass --confirm to actually apply.

Hard policy (refused at CLI level, NOT at LLM level):
  - max bid                 $CC_GADS_MAX_BID_USD               (default $15.00)
  - max budget delta        $CC_GADS_MAX_BUDGET_DELTA_PCT %    (default 25%)
  - protected pattern       /_PROD_|_LIVE_|^Brand_/  (override: CC_GADS_ALLOW_PROTECTED=1)
  - new campaigns           always created PAUSED

Auth: reads from ~/.config/cc-google-ads/env (sourced via .bashrc).
Required env: GOOGLE_ADS_DEVELOPER_TOKEN, GOOGLE_ADS_LOGIN_CUSTOMER_ID,
              CC_GADS_DEFAULT_CUSTOMER_ID, plus OAuth credentials (either
              GOOGLE_APPLICATION_CREDENTIALS pointing at the gcloud ADC JSON,
              OR the explicit refresh_token / client_id / client_secret triple).
"""
import datetime
import json
import os
import re
import sys
from pathlib import Path

import click

try:
    from google.ads.googleads.client import GoogleAdsClient
    from google.ads.googleads.errors import GoogleAdsException
except ImportError:
    sys.exit(
        "ERROR: google-ads-python SDK not installed. "
        "Install: pip install google-ads click  (or install into the venv that runs cc-gads)"
    )


# ───── Policy from env (read at call time, not import time) ─────

def _env(name: str, default: str = "") -> str:
    return os.environ.get(name, default)


def _customer_id() -> str:
    cid = _env("CC_GADS_DEFAULT_CUSTOMER_ID").replace("-", "")
    if not cid:
        sys.exit("REFUSE: CC_GADS_DEFAULT_CUSTOMER_ID not set in env")
    return cid


def _login_customer_id() -> str:
    return _env("GOOGLE_ADS_LOGIN_CUSTOMER_ID").replace("-", "")


def _max_bid_usd() -> float:
    return float(_env("CC_GADS_MAX_BID_USD", "15.00"))


def _max_budget_delta_pct() -> float:
    return float(_env("CC_GADS_MAX_BUDGET_DELTA_PCT", "25"))


def _allow_protected() -> bool:
    return _env("CC_GADS_ALLOW_PROTECTED", "0") == "1"


PROTECTED_PATTERN = re.compile(r"_PROD_|_LIVE_|^Brand_")
AUDIT_LOG = Path.home() / ".config" / "cc-google-ads" / "audit.log"


# ───── Auth ─────

def _build_client() -> GoogleAdsClient:
    """Build a GoogleAdsClient.

    Prefers explicit OAuth refresh_token credentials in env
    (GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_REFRESH_TOKEN)
    — same triple Phase 1 sync uses, lifted from app_cc/.env if Marc copies them.

    Falls back to GOOGLE_APPLICATION_CREDENTIALS (the gcloud ADC user-creds JSON
    written by `gcloud auth application-default login`), parsing out the
    refresh_token / client_id / client_secret stored inside.
    """
    dev_token = _env("GOOGLE_ADS_DEVELOPER_TOKEN")
    if not dev_token:
        sys.exit("REFUSE: GOOGLE_ADS_DEVELOPER_TOKEN not set in env")

    config: dict[str, object] = {
        "developer_token": dev_token,
        "use_proto_plus": True,
    }
    login_cid = _login_customer_id()
    if login_cid:
        config["login_customer_id"] = login_cid

    # Path 1: explicit OAuth env triple
    client_id = _env("GOOGLE_OAUTH_CLIENT_ID") or _env("GOOGLE_ADS_CLIENT_ID")
    client_secret = _env("GOOGLE_OAUTH_CLIENT_SECRET") or _env("GOOGLE_ADS_CLIENT_SECRET")
    refresh_token = _env("GOOGLE_OAUTH_REFRESH_TOKEN") or _env("GOOGLE_ADS_REFRESH_TOKEN")

    if client_id and client_secret and refresh_token:
        config["client_id"] = client_id
        config["client_secret"] = client_secret
        config["refresh_token"] = refresh_token
        return GoogleAdsClient.load_from_dict(config)

    # Path 2: gcloud ADC user-creds JSON
    adc_path = _env("GOOGLE_APPLICATION_CREDENTIALS")
    if adc_path and Path(adc_path).is_file():
        try:
            adc = json.loads(Path(adc_path).read_text())
        except Exception as e:
            sys.exit(f"REFUSE: cannot parse GOOGLE_APPLICATION_CREDENTIALS at {adc_path}: {e}")
        if adc.get("type") == "authorized_user":
            config["client_id"] = adc["client_id"]
            config["client_secret"] = adc["client_secret"]
            config["refresh_token"] = adc["refresh_token"]
            return GoogleAdsClient.load_from_dict(config)
        sys.exit(
            f"REFUSE: ADC JSON at {adc_path} is type={adc.get('type')!r}; "
            "cc-gads requires user credentials (run `gcloud auth application-default login`)."
        )

    sys.exit(
        "REFUSE: no OAuth credentials found. Either set GOOGLE_OAUTH_CLIENT_ID + "
        "GOOGLE_OAUTH_CLIENT_SECRET + GOOGLE_OAUTH_REFRESH_TOKEN, or run "
        "`gcloud auth application-default login` and ensure GOOGLE_APPLICATION_CREDENTIALS "
        "points at the resulting JSON."
    )


# ───── Policy guards ─────

def _check_protected(name: str) -> None:
    if PROTECTED_PATTERN.search(name) and not _allow_protected():
        sys.exit(
            f"REFUSE: {name!r} matches protected pattern /_PROD_|_LIVE_|^Brand_/. "
            "Set CC_GADS_ALLOW_PROTECTED=1 in your shell only when explicitly intended."
        )


def _check_bid(amount_usd: float) -> None:
    ceiling = _max_bid_usd()
    if amount_usd > ceiling:
        sys.exit(f"REFUSE: bid ${amount_usd:.2f} exceeds ceiling ${ceiling:.2f}")


def _check_budget_delta(old_usd: float, new_usd: float) -> None:
    if old_usd <= 0:
        return
    delta_pct = abs(new_usd - old_usd) / old_usd * 100
    ceiling = _max_budget_delta_pct()
    if delta_pct > ceiling:
        sys.exit(
            f"REFUSE: budget delta {delta_pct:.1f}% exceeds {ceiling:.1f}%. "
            f"Old=${old_usd:.2f} New=${new_usd:.2f}"
        )


# ───── Audit log ─────

def _audit(op: str, dry_run: bool, payload: dict) -> None:
    AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
    record = {
        "ts": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
        "op": op,
        "dry_run": dry_run,
        "customer_id": _customer_id(),
        "login_customer_id": _login_customer_id() or None,
        "payload": payload,
    }
    with open(AUDIT_LOG, "a") as f:
        f.write(json.dumps(record) + "\n")


def _handle_ads_exception(e: "GoogleAdsException") -> None:
    click.echo(f"GoogleAdsException: request_id={e.request_id} status={e.error.code().name}", err=True)
    for err in e.failure.errors:
        click.echo(f"  - {err.message}", err=True)
        if err.location:
            for fpe in err.location.field_path_elements:
                click.echo(f"    at {fpe.field_name}", err=True)
    sys.exit(1)


# ───── CLI ─────

@click.group()
def cli() -> None:
    """Cinematic Composing Google Ads CLI. All mutations are dry-run by default."""


# ────────── list-campaigns ──────────

@cli.command("list-campaigns")
@click.option(
    "--status",
    default="ENABLED",
    type=click.Choice(["ENABLED", "PAUSED", "REMOVED", "ALL"]),
    help="Filter by status (default ENABLED).",
)
def list_campaigns(status: str) -> None:
    """List campaigns in the account. Read-only."""
    client = _build_client()
    cid = _customer_id()
    ga = client.get_service("GoogleAdsService")

    where = "" if status == "ALL" else f"WHERE campaign.status = '{status}'"
    query = (
        "SELECT campaign.id, campaign.name, campaign.status, "
        "campaign.advertising_channel_type "
        f"FROM campaign {where} ORDER BY campaign.name"
    )
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return

    click.echo(f"{'ID':<14}{'STATUS':<10}{'CHANNEL':<22}NAME")
    click.echo("─" * 80)
    for r in rows:
        c = r.campaign
        click.echo(
            f"{c.id:<14}{c.status.name:<10}{c.advertising_channel_type.name:<22}{c.name}"
        )
    click.echo(f"\n{len(rows)} campaign(s).")


# ────────── list-ad-groups ──────────

@cli.command("list-ad-groups")
@click.argument("campaign_id")
def list_ad_groups(campaign_id: str) -> None:
    """List ad groups in a campaign with their max-CPC bids. Read-only."""
    client = _build_client()
    cid = _customer_id()
    ga = client.get_service("GoogleAdsService")

    query = (
        "SELECT ad_group.id, ad_group.name, ad_group.status, ad_group.cpc_bid_micros, "
        "campaign.name "
        f"FROM ad_group WHERE campaign.id = {campaign_id} ORDER BY ad_group.name"
    )
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return

    if not rows:
        click.echo(f"No ad groups in campaign {campaign_id}.")
        return

    click.echo(f"Campaign: {rows[0].campaign.name}")
    click.echo(f"{'AD GROUP ID':<14}{'STATUS':<10}{'MAX CPC':<10}NAME")
    click.echo("─" * 80)
    for r in rows:
        ag = r.ad_group
        cpc_usd = ag.cpc_bid_micros / 1_000_000 if ag.cpc_bid_micros else 0
        click.echo(f"{ag.id:<14}{ag.status.name:<10}${cpc_usd:<9.2f}{ag.name}")
    click.echo(f"\n{len(rows)} ad group(s).")


# ────────── set-budget ──────────

@cli.command("set-budget")
@click.argument("campaign_id")
@click.argument("new_amount_usd", type=float)
@click.option("--confirm", is_flag=True, help="Skip dry-run and execute.")
def set_budget(campaign_id: str, new_amount_usd: float, confirm: bool) -> None:
    """Set a campaign's daily budget (USD). Default behavior is dry-run."""
    client = _build_client()
    cid = _customer_id()
    ga = client.get_service("GoogleAdsService")

    query = (
        "SELECT campaign.name, campaign_budget.id, campaign_budget.amount_micros "
        f"FROM campaign WHERE campaign.id = {campaign_id}"
    )
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return
    if not rows:
        sys.exit(f"campaign {campaign_id} not found")

    row = rows[0]
    name = row.campaign.name
    budget_id = row.campaign_budget.id
    old_micros = row.campaign_budget.amount_micros
    old_usd = old_micros / 1_000_000

    _check_protected(name)
    _check_budget_delta(old_usd, new_amount_usd)

    delta_usd = new_amount_usd - old_usd
    delta_pct = (delta_usd / old_usd * 100) if old_usd > 0 else 0
    payload = {
        "campaign_id": campaign_id,
        "name": name,
        "old_usd": old_usd,
        "new_usd": new_amount_usd,
        "delta_pct": round(delta_pct, 2),
    }

    if not confirm:
        click.echo("DRY-RUN — no changes applied.")
        click.echo(f"Resource: {name} (campaign {campaign_id})")
        click.echo(f"Field:    daily budget")
        click.echo(f"Old:      ${old_usd:.2f}")
        click.echo(f"New:      ${new_amount_usd:.2f}")
        click.echo(f"Delta:    {delta_usd:+.2f} ({delta_pct:+.1f}%)")
        click.echo("\nRe-run with --confirm to apply.")
        _audit("set-budget", dry_run=True, payload=payload)
        return

    bs = client.get_service("CampaignBudgetService")
    op = client.get_type("CampaignBudgetOperation")
    op.update.resource_name = bs.campaign_budget_path(cid, budget_id)
    op.update.amount_micros = int(round(new_amount_usd * 1_000_000))
    op.update_mask.paths.append("amount_micros")

    try:
        bs.mutate_campaign_budgets(customer_id=cid, operations=[op])
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return

    _audit("set-budget", dry_run=False, payload=payload)
    click.echo(f"OK — {name} budget set to ${new_amount_usd:.2f}")


# ────────── set-bid ──────────

@cli.command("set-bid")
@click.argument("ad_group_id")
@click.argument("new_cpc_usd", type=float)
@click.option("--confirm", is_flag=True)
def set_bid(ad_group_id: str, new_cpc_usd: float, confirm: bool) -> None:
    """Set an ad group's max CPC bid (USD). Default behavior is dry-run."""
    _check_bid(new_cpc_usd)

    client = _build_client()
    cid = _customer_id()
    ga = client.get_service("GoogleAdsService")

    query = (
        "SELECT ad_group.id, ad_group.name, ad_group.cpc_bid_micros, campaign.name "
        f"FROM ad_group WHERE ad_group.id = {ad_group_id}"
    )
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return
    if not rows:
        sys.exit(f"ad group {ad_group_id} not found")

    row = rows[0]
    ag_name = row.ad_group.name
    camp_name = row.campaign.name
    old_micros = row.ad_group.cpc_bid_micros
    old_usd = old_micros / 1_000_000 if old_micros else 0

    _check_protected(camp_name)
    _check_protected(ag_name)

    payload = {
        "ad_group_id": ad_group_id,
        "ad_group_name": ag_name,
        "campaign_name": camp_name,
        "old_usd": old_usd,
        "new_usd": new_cpc_usd,
    }

    if not confirm:
        click.echo("DRY-RUN — no changes applied.")
        click.echo(f"Resource: {ag_name} (ad group {ad_group_id})")
        click.echo(f"Campaign: {camp_name}")
        click.echo(f"Field:    max CPC bid")
        click.echo(f"Old:      ${old_usd:.2f}")
        click.echo(f"New:      ${new_cpc_usd:.2f}")
        click.echo("\nRe-run with --confirm to apply.")
        _audit("set-bid", dry_run=True, payload=payload)
        return

    ags = client.get_service("AdGroupService")
    op = client.get_type("AdGroupOperation")
    op.update.resource_name = ags.ad_group_path(cid, ad_group_id)
    op.update.cpc_bid_micros = int(round(new_cpc_usd * 1_000_000))
    op.update_mask.paths.append("cpc_bid_micros")

    try:
        ags.mutate_ad_groups(customer_id=cid, operations=[op])
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return

    _audit("set-bid", dry_run=False, payload=payload)
    click.echo(f"OK — {ag_name} max CPC set to ${new_cpc_usd:.2f}")


# ────────── pause-campaign / enable-campaign ──────────

def _set_campaign_status(campaign_id: str, target_status: str, confirm: bool) -> None:
    client = _build_client()
    cid = _customer_id()
    ga = client.get_service("GoogleAdsService")

    query = (
        "SELECT campaign.id, campaign.name, campaign.status "
        f"FROM campaign WHERE campaign.id = {campaign_id}"
    )
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return
    if not rows:
        sys.exit(f"campaign {campaign_id} not found")

    row = rows[0]
    name = row.campaign.name
    old_status = row.campaign.status.name

    _check_protected(name)

    payload = {
        "campaign_id": campaign_id,
        "name": name,
        "old_status": old_status,
        "new_status": target_status,
    }

    if old_status == target_status:
        click.echo(f"NO-OP — {name} is already {target_status}.")
        _audit(f"set-status:{target_status.lower()}", dry_run=True, payload=payload)
        return

    if not confirm:
        click.echo("DRY-RUN — no changes applied.")
        click.echo(f"Resource: {name} (campaign {campaign_id})")
        click.echo(f"Field:    status")
        click.echo(f"Old:      {old_status}")
        click.echo(f"New:      {target_status}")
        click.echo("\nRe-run with --confirm to apply.")
        _audit(f"set-status:{target_status.lower()}", dry_run=True, payload=payload)
        return

    cs = client.get_service("CampaignService")
    op = client.get_type("CampaignOperation")
    op.update.resource_name = cs.campaign_path(cid, campaign_id)
    op.update.status = client.enums.CampaignStatusEnum[target_status]
    op.update_mask.paths.append("status")

    try:
        cs.mutate_campaigns(customer_id=cid, operations=[op])
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return

    _audit(f"set-status:{target_status.lower()}", dry_run=False, payload=payload)
    click.echo(f"OK — {name} → {target_status}")


@cli.command("pause-campaign")
@click.argument("campaign_id")
@click.option("--confirm", is_flag=True)
def pause_campaign(campaign_id: str, confirm: bool) -> None:
    """Pause a campaign. Default behavior is dry-run."""
    _set_campaign_status(campaign_id, "PAUSED", confirm)


@cli.command("enable-campaign")
@click.argument("campaign_id")
@click.option("--confirm", is_flag=True)
def enable_campaign(campaign_id: str, confirm: bool) -> None:
    """Enable a paused campaign. Default behavior is dry-run."""
    _set_campaign_status(campaign_id, "ENABLED", confirm)


# ────────── add-negative-keyword ──────────

@cli.command("add-negative-keyword")
@click.argument("campaign_id")
@click.argument("keyword")
@click.option(
    "--match",
    default="exact",
    type=click.Choice(["exact", "phrase", "broad"]),
    help="Keyword match type (default exact).",
)
@click.option("--confirm", is_flag=True)
def add_negative_keyword(campaign_id: str, keyword: str, match: str, confirm: bool) -> None:
    """Add a campaign-level negative keyword. Low-risk write."""
    client = _build_client()
    cid = _customer_id()
    ga = client.get_service("GoogleAdsService")

    query = f"SELECT campaign.id, campaign.name FROM campaign WHERE campaign.id = {campaign_id}"
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return
    if not rows:
        sys.exit(f"campaign {campaign_id} not found")

    name = rows[0].campaign.name
    _check_protected(name)

    payload = {
        "campaign_id": campaign_id,
        "name": name,
        "keyword": keyword,
        "match_type": match.upper(),
    }

    if not confirm:
        click.echo("DRY-RUN — no changes applied.")
        click.echo(f"Resource: {name} (campaign {campaign_id})")
        click.echo(f"Action:   add negative keyword")
        click.echo(f"Keyword:  {keyword!r}")
        click.echo(f"Match:    {match.upper()}")
        click.echo("\nRe-run with --confirm to apply.")
        _audit("add-negative-keyword", dry_run=True, payload=payload)
        return

    ccs = client.get_service("CampaignCriterionService")
    op = client.get_type("CampaignCriterionOperation")
    crit = op.create
    crit.campaign = client.get_service("CampaignService").campaign_path(cid, campaign_id)
    crit.negative = True
    crit.keyword.text = keyword
    crit.keyword.match_type = client.enums.KeywordMatchTypeEnum[match.upper()]

    try:
        ccs.mutate_campaign_criteria(customer_id=cid, operations=[op])
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return

    _audit("add-negative-keyword", dry_run=False, payload=payload)
    click.echo(f"OK — added negative keyword {keyword!r} ({match}) to {name}")


# ────────── set-tracking-template ──────────

def _set_tracking_template_campaign(client, cid, campaign_id, new_template, confirm):
    """Update one campaign's tracking_url_template. Returns (ok, name, old, new)."""
    ga = client.get_service("GoogleAdsService")
    query = (
        "SELECT campaign.id, campaign.name, campaign.tracking_url_template "
        f"FROM campaign WHERE campaign.id = {campaign_id}"
    )
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return (False, None, None, None)
    if not rows:
        click.echo(f"  SKIP campaign {campaign_id} not found", err=True)
        return (False, None, None, None)

    row = rows[0]
    name = row.campaign.name
    old = row.campaign.tracking_url_template or ""
    _check_protected(name)

    payload = {
        "level": "campaign",
        "campaign_id": campaign_id,
        "name": name,
        "old_template": old,
        "new_template": new_template,
    }

    if old == new_template:
        click.echo(f"  NO-OP campaign {campaign_id} {name!r} already at target.")
        _audit("set-tracking-template", dry_run=True, payload=payload)
        return (True, name, old, new_template)

    if not confirm:
        _audit("set-tracking-template", dry_run=True, payload=payload)
        return (True, name, old, new_template)

    cs = client.get_service("CampaignService")
    op = client.get_type("CampaignOperation")
    op.update.resource_name = cs.campaign_path(cid, campaign_id)
    op.update.tracking_url_template = new_template
    op.update_mask.paths.append("tracking_url_template")
    try:
        cs.mutate_campaigns(customer_id=cid, operations=[op])
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return (False, name, old, new_template)
    _audit("set-tracking-template", dry_run=False, payload=payload)
    return (True, name, old, new_template)


def _set_tracking_template_ad_group(client, cid, ad_group_id, new_template, confirm):
    """Update one ad_group's tracking_url_template. Returns (ok, name, old, new)."""
    ga = client.get_service("GoogleAdsService")
    query = (
        "SELECT ad_group.id, ad_group.name, ad_group.tracking_url_template, campaign.name "
        f"FROM ad_group WHERE ad_group.id = {ad_group_id}"
    )
    try:
        rows = list(ga.search(customer_id=cid, query=query))
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return (False, None, None, None)
    if not rows:
        click.echo(f"  SKIP ad group {ad_group_id} not found", err=True)
        return (False, None, None, None)

    row = rows[0]
    ag_name = row.ad_group.name
    camp_name = row.campaign.name
    old = row.ad_group.tracking_url_template or ""
    _check_protected(camp_name)
    _check_protected(ag_name)

    payload = {
        "level": "ad_group",
        "ad_group_id": ad_group_id,
        "ad_group_name": ag_name,
        "campaign_name": camp_name,
        "old_template": old,
        "new_template": new_template,
    }

    if old == new_template:
        click.echo(f"  NO-OP ad group {ad_group_id} {ag_name!r} already at target.")
        _audit("set-tracking-template", dry_run=True, payload=payload)
        return (True, f"{camp_name} / {ag_name}", old, new_template)

    if not confirm:
        _audit("set-tracking-template", dry_run=True, payload=payload)
        return (True, f"{camp_name} / {ag_name}", old, new_template)

    ags = client.get_service("AdGroupService")
    op = client.get_type("AdGroupOperation")
    op.update.resource_name = ags.ad_group_path(cid, ad_group_id)
    op.update.tracking_url_template = new_template
    op.update_mask.paths.append("tracking_url_template")
    try:
        ags.mutate_ad_groups(customer_id=cid, operations=[op])
    except GoogleAdsException as e:
        _handle_ads_exception(e)
        return (False, f"{camp_name} / {ag_name}", old, new_template)
    _audit("set-tracking-template", dry_run=False, payload=payload)
    return (True, f"{camp_name} / {ag_name}", old, new_template)


@cli.command("set-tracking-template")
@click.option("--campaign-id", default=None, help="Single campaign ID to update.")
@click.option("--ad-group-id", default=None, help="Single ad group ID to update.")
@click.option(
    "--from-tsv",
    "from_tsv",
    default=None,
    type=click.Path(exists=True, dir_okay=False),
    help="Bulk: TSV file with columns level/status/campaign/ad_group/current_template/campaign_id/ad_group_id (header required).",
)
@click.option("--template", "template", required=True, help="New tracking_url_template value (literal string).")
@click.option("--confirm", is_flag=True, help="Skip dry-run and execute.")
def set_tracking_template(campaign_id, ad_group_id, from_tsv, template, confirm):
    """Set tracking_url_template on a campaign, ad group, or bulk-from-TSV. Dry-run by default."""
    targets = [t for t in (campaign_id, ad_group_id, from_tsv) if t]
    if len(targets) != 1:
        sys.exit("REFUSE: pass exactly one of --campaign-id, --ad-group-id, --from-tsv.")

    client = _build_client()
    cid = _customer_id()

    # Build the worklist: list of ("campaign"|"ad_group", id) tuples.
    worklist: list[tuple[str, str]] = []
    if campaign_id:
        worklist.append(("campaign", campaign_id))
    elif ad_group_id:
        worklist.append(("ad_group", ad_group_id))
    else:
        with open(from_tsv) as f:
            header = f.readline().rstrip("\n").split("\t")
            try:
                i_level = header.index("level")
                i_camp = header.index("campaign_id")
                i_ag = header.index("ad_group_id")
            except ValueError:
                sys.exit(
                    "REFUSE: --from-tsv expects a header row with columns including "
                    "'level', 'campaign_id', 'ad_group_id'."
                )
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) <= max(i_level, i_camp, i_ag):
                    continue
                lvl = parts[i_level].strip()
                if lvl == "campaign" and parts[i_camp].strip():
                    worklist.append(("campaign", parts[i_camp].strip()))
                elif lvl == "ad_group" and parts[i_ag].strip():
                    worklist.append(("ad_group", parts[i_ag].strip()))

    if not worklist:
        sys.exit("REFUSE: empty worklist.")

    mode = "EXECUTE" if confirm else "DRY-RUN"
    click.echo(f"{mode} — {len(worklist)} target(s). Target template: {template!r}")
    click.echo("─" * 80)

    ok = 0
    fail = 0
    diffs: list[tuple[str, str, str, str]] = []  # (kind, name, old, new)
    for kind, rid in worklist:
        if kind == "campaign":
            success, name, old, new = _set_tracking_template_campaign(client, cid, rid, template, confirm)
        else:
            success, name, old, new = _set_tracking_template_ad_group(client, cid, rid, template, confirm)
        if success and name is not None and old != new:
            diffs.append((kind, name, old, new))
            ok += 1
        elif success:
            ok += 1
        else:
            fail += 1

    # Print a compact diff table (show first 20, then summarize).
    for kind, name, old, new in diffs[:20]:
        click.echo(f"  [{kind:<8}] {name}")
        click.echo(f"      OLD: {old!r}")
        click.echo(f"      NEW: {new!r}")
    if len(diffs) > 20:
        click.echo(f"  … and {len(diffs) - 20} more changes.")

    click.echo("─" * 80)
    click.echo(f"{mode}: {ok} succeeded, {fail} failed, {len(diffs)} would-change.")
    if not confirm:
        click.echo("Re-run with --confirm to apply.")


