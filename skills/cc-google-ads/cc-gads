@cli.command("env-check")
def env_check() -> None:
    """Report whether all required env vars are present (no values printed)."""
    required = [
        "GOOGLE_ADS_DEVELOPER_TOKEN",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID",
        "CC_GADS_DEFAULT_CUSTOMER_ID",
    ]
    optional_auth = [
        ("GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET", "GOOGLE_OAUTH_REFRESH_TOKEN"),
        ("GOOGLE_APPLICATION_CREDENTIALS",),
    ]
    click.echo("Required env vars:")
    for v in required:
        click.echo(f"  {v}: {'SET' if _env(v) else 'MISSING'}")
    click.echo("\nAuth (need at least ONE complete path):")
    for path in optional_auth:
        all_set = all(_env(v) for v in path)
        click.echo(f"  {' + '.join(path)}: {'COMPLETE' if all_set else 'incomplete'}")
    click.echo(f"\nCeilings: max_bid=${_max_bid_usd():.2f}, max_budget_delta_pct={_max_budget_delta_pct():.1f}%")
    click.echo(f"Allow protected: {_allow_protected()}")
    click.echo(f"Audit log: {AUDIT_LOG} (exists: {AUDIT_LOG.is_file()})")


